# Base directory for config and output. n8n must have read/write access.
# Example: /data (then config at /data/config/, output at /data/output/)
N8N_CONFIG_PATH=
N8N_OUTPUT_PATH=

# Optional: if you prefer to pass API keys via env instead of n8n credentials
# JSEARCH_RAPIDAPI_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
